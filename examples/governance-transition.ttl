@prefix ex: <https://example.org/kee/> .
@prefix kee: <https://w3id.org/kee#> .
@prefix profile: <https://w3id.org/kee/profile#> .
@prefix grlife: <https://w3id.org/kee/lifecycle/governance-record#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# KEE Governance Transition Profile Example
# Status: Draft / Non-Normative profile example (specification Section 19); legacy-readable compatibility example
#
# Compatibility note (registered legacy compatibility window, specification Section 17): this example intentionally
# exercises registered legacy-readable surfaces (for example kee:profileConformance,
# kee:artifactType, or the generic https://w3id.org/kee/lifecycle# namespace). It is
# compatibility evidence, not canonical new-write guidance. Canonical new writes
# use dcterms:conformsTo, dcterms:type, and the profile-specific lifecycle
# namespaces named in docs/specs/KEE-Specification-v0.11.0.md Sections 8-9.
# Run `kee normalize --rewrite-safe examples/<file>` to see the safe carrier
# rewrites and the remaining unsafe legacy surfaces.
# Version: 0.1.0
# Repository path: examples/governance-transition.ttl
#
# Expected validation target:
#   shacl/governance-transition-profile.ttl
#
# Expected result:
#   valid, with no required-field violations.
#
# This is a normative conformance fixture (unlike the illustrative sketch kept
# with the profile document, which intentionally uses placeholder exprof:
# predicates and is not registered in the conformance manifest). It mirrors the same scenario -- a managed
# assertion unit moving from a local "Proposed" status to "Accepted" --
# using the real kee: predicates adopted by a recorded project decision.

ex:transition-accept-assertion-042
    a kee:GovernanceTransitionRecord ;
    rdfs:label "Transition record: assertion-042 Proposed to Accepted"@en ;

    kee:governedArtifact ex:assertion-unit-042 ;
    kee:previousLifecycleState ex:local-status-proposed ;
    kee:newLifecycleState ex:local-status-accepted ;
    kee:lifecycleStatusVocabulary ex:lifecycle-profile-team-assertions-2026 ;
    kee:lifecycleState grlife:Accepted ;
    kee:profileConformance profile:GovernanceTransitionProfile ;
    kee:authorityEvidence ex:delegation-record-team-kb-stewards ;
    kee:scope ex:scope-observability-runbooks ;
    kee:context ex:context-incident-review ;

    skos:changeNote "Accepted for the team knowledge base after steward review of the cited evidence packet; acceptance records governance status only and does not assert high confidence."@en ;

    dcterms:source ex:evidence-packet-2026-07-03 ;

    prov:wasGeneratedBy ex:transition-activity-accept-assertion-042 ;
    prov:wasAttributedTo ex:agent-data-steward ;
    prov:generatedAtTime "2026-07-10T14:19:02Z"^^xsd:dateTime .

ex:transition-activity-accept-assertion-042
    a prov:Activity ;
    rdfs:label "Transition activity: accept assertion-042"@en ;
    prov:wasAssociatedWith ex:agent-data-steward .

ex:assertion-unit-042
    a prov:Entity ;
    rdfs:label "Managed assertion unit 042"@en .

ex:local-status-proposed
    a skos:Concept ;
    skos:prefLabel "Proposed"@en .

ex:local-status-accepted
    a skos:Concept ;
    skos:prefLabel "Accepted"@en .

ex:lifecycle-profile-team-assertions-2026
    a skos:ConceptScheme ;
    rdfs:label "Team assertions lifecycle-status vocabulary"@en .

ex:agent-data-steward
    a prov:Agent ;
    rdfs:label "Data Steward"@en .

ex:delegation-record-team-kb-stewards
    a prov:Entity ;
    rdfs:label "Delegation record: team KB stewards"@en .

ex:evidence-packet-2026-07-03
    a prov:Entity ;
    rdfs:label "Evidence packet 2026-07-03"@en .

ex:scope-observability-runbooks
    a skos:Concept ;
    skos:prefLabel "Observability runbooks scope"@en .

ex:context-incident-review
    a skos:Concept ;
    skos:prefLabel "Incident review context"@en .
