@prefix ex: <https://example.org/kee/> .
@prefix kee: <https://w3id.org/kee#> .
@prefix profile: <https://w3id.org/kee/profile#> .
@prefix grlife: <https://w3id.org/kee/lifecycle/governance-record#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# KEE Authority and Delegation Profile Example
# Status: Draft / Non-Normative profile example (specification Section 19); legacy-readable compatibility example
#
# Compatibility note (registered legacy compatibility window, specification Section 17): this example intentionally
# exercises registered legacy-readable surfaces (for example kee:profileConformance,
# kee:artifactType, or the generic https://w3id.org/kee/lifecycle# namespace). It is
# compatibility evidence, not canonical new-write guidance. Canonical new writes
# use dcterms:conformsTo, dcterms:type, and the profile-specific lifecycle
# namespaces named in docs/specs/KEE-Specification-v0.11.0.md Sections 8-9.
# Run `kee normalize --rewrite-safe examples/<file>` to see the safe carrier
# rewrites and the remaining unsafe legacy surfaces.
# Expected result: conforms to shacl/authority-delegation-profile.ttl.
#
# This source fixture intentionally retains legacy kee:profileConformance so
# the frozen compatibility regression can prove both legacy reads and automatic
# conversion to dcterms:conformsTo new-write form. The authority profile does
# not reopen that frozen compatibility contract.

# Direct authority grant. Authority scope and artifact applicability scope are
# deliberately different values so the example demonstrates that the two
# scopes are distinct obligations.
ex:authority-record-priya-standards-chair
    a kee:GovernanceTransitionRecord, kee:AuthorityRecord ;
    rdfs:label "Authority record: Priya, standards committee chair"@en ;
    kee:governedArtifact ex:standards-committee-charter ;
    kee:newLifecycleState ex:status-granted ;
    kee:lifecycleStatusVocabulary ex:authority-status-vocabulary ;
    kee:lifecycleState grlife:Accepted ;
    kee:profileConformance profile:AuthorityDelegationProfile ;
    kee:authorityEvidence ex:charter-engineering-standards-committee ;
    kee:scope ex:scope-charter-applicability ;
    kee:grantedTo ex:agent-priya-standards-chair ;
    kee:authorityScope ex:scope-org-wide-engineering-governance ;
    kee:validFrom "2026-01-15"^^xsd:date ;
    kee:validUntil "2027-01-15"^^xsd:date ;
    prov:wasGeneratedBy ex:authority-grant-priya-activity ;
    prov:wasAttributedTo ex:governance-log-service ;
    prov:generatedAtTime "2026-01-15T09:05:00Z"^^xsd:dateTime .

ex:authority-grant-priya-activity
    a prov:Activity ;
    prov:qualifiedAssociation [
        a prov:Association ;
        prov:agent ex:agent-vp-engineering ;
        prov:hadRole ex:role-authority-grantor
    ] .

# Delegated software-agent authority. The delegation relation is asserted on
# the delegate Agent, not on the AuthorityRecord. The chain terminates at a
# person authority root.
ex:authority-record-policy-lint-bot
    a kee:GovernanceTransitionRecord, kee:AuthorityRecord ;
    rdfs:label "Authority record: policy lint bot"@en ;
    kee:governedArtifact ex:runbook-format-policy ;
    kee:newLifecycleState ex:status-granted ;
    kee:lifecycleStatusVocabulary ex:authority-status-vocabulary ;
    kee:lifecycleState grlife:Accepted ;
    kee:profileConformance profile:AuthorityDelegationProfile ;
    kee:authorityEvidence ex:delegation-policy-lint-bot ;
    kee:scope ex:scope-runbook-format-policy-applicability ;
    kee:grantedTo ex:agent-policy-lint-bot ;
    kee:authorityScope ex:scope-runbook-format-checks-only ;
    kee:validFrom "2026-02-01"^^xsd:date ;
    prov:wasGeneratedBy ex:authority-grant-bot-activity ;
    prov:wasAttributedTo ex:governance-log-service ;
    prov:generatedAtTime "2026-02-01T00:05:00Z"^^xsd:dateTime .

ex:authority-grant-bot-activity
    a prov:Activity ;
    prov:qualifiedAssociation [
        a prov:Association ;
        prov:agent ex:agent-priya-standards-chair ;
        prov:hadRole ex:role-authority-delegator
    ] .

ex:agent-policy-lint-bot
    a prov:Agent, prov:SoftwareAgent ;
    prov:actedOnBehalfOf ex:agent-priya-standards-chair ;
    rdfs:label "Policy lint bot"@en .

# Revocation is distinct from scheduled expiration. The original grant record
# remains queryable and may carry a separate invalidation timestamp.
ex:authority-record-sam-former-chair
    a kee:GovernanceTransitionRecord, kee:AuthorityRecord ;
    rdfs:label "Authority record: Sam, former chair"@en ;
    kee:governedArtifact ex:standards-committee-charter ;
    kee:newLifecycleState ex:status-revoked ;
    kee:lifecycleStatusVocabulary ex:authority-status-vocabulary ;
    kee:lifecycleState grlife:Accepted ;
    kee:profileConformance profile:AuthorityDelegationProfile ;
    kee:authorityEvidence ex:charter-engineering-standards-committee-2025 ;
    kee:scope ex:scope-charter-applicability ;
    kee:grantedTo ex:agent-sam-former-chair ;
    kee:authorityScope ex:scope-org-wide-engineering-governance ;
    kee:validFrom "2025-01-10"^^xsd:date ;
    kee:validUntil "2026-12-31"^^xsd:date ;
    prov:invalidatedAtTime "2026-01-15T09:00:00Z"^^xsd:dateTime ;
    prov:wasGeneratedBy ex:authority-grant-sam-activity ;
    prov:wasAttributedTo ex:governance-log-service ;
    prov:generatedAtTime "2025-01-10T09:05:00Z"^^xsd:dateTime .

ex:authority-grant-sam-activity
    a prov:Activity ;
    prov:qualifiedAssociation [
        a prov:Association ;
        prov:agent ex:agent-vp-engineering ;
        prov:hadRole ex:role-authority-grantor
    ] .

ex:contested-authority-payments-escalation-threshold
    a kee:ContestedAuthorityClaim ;
    rdfs:label "Contested authority: payments escalation thresholds"@en ;
    kee:claimant ex:agent-priya-standards-chair, ex:agent-jordan-payments-lead ;
    kee:lifecycleState grlife:Accepted ;
    kee:profileConformance profile:AuthorityDelegationProfile ;
    kee:contestedScope ex:scope-payments-alert-escalation-thresholds ;
    dcterms:description "Two agents claim overlapping authority; neither claim is silently suppressed."@en ;
    kee:knownContradiction ex:contradiction-escalation-threshold ;
    prov:wasAttributedTo ex:governance-log-service ;
    prov:generatedAtTime "2026-07-10T10:00:00Z"^^xsd:dateTime .

ex:standards-committee-charter a prov:Entity .
ex:runbook-format-policy a prov:Entity .
ex:status-granted a skos:Concept .
ex:status-revoked a skos:Concept .
ex:authority-status-vocabulary a skos:ConceptScheme .
ex:charter-engineering-standards-committee a prov:Entity .
ex:charter-engineering-standards-committee-2025 a prov:Entity .
ex:delegation-policy-lint-bot a prov:Entity .
ex:scope-charter-applicability a skos:Concept .
ex:scope-org-wide-engineering-governance a skos:Concept .
ex:scope-runbook-format-policy-applicability a skos:Concept .
ex:scope-runbook-format-checks-only a skos:Concept .
ex:scope-payments-alert-escalation-thresholds a skos:Concept .
ex:role-authority-grantor a prov:Role .
ex:role-authority-delegator a prov:Role .
ex:agent-priya-standards-chair a prov:Agent, prov:Person .
ex:agent-sam-former-chair a prov:Agent, prov:Person .
ex:agent-vp-engineering a prov:Agent, prov:Person .
ex:agent-jordan-payments-lead a prov:Agent, prov:Person .
ex:governance-log-service a prov:Agent, prov:SoftwareAgent .

# The linked contradiction record, carried complete so that it conforms to
# shacl/contradiction-records-profile.ttl as well; examples/contradiction-records.ttl
# holds the same record with its side/evidence pairing.
ex:contradiction-escalation-threshold
    a kee:ContradictionRecord ;
    rdfs:label "Escalation threshold contradiction"@en ;
    kee:conflictingArtifact ex:runbook-incident-triage-v3, ex:runbook-incident-triage-payments ;
    kee:lifecycleState grlife:Accepted ;
    dcterms:conformsTo profile:ContradictionRecordsProfile ;
    dcterms:description "The org-wide standard runbook recommends a 15-minute escalation threshold based on alert-fatigue postmortem data. The payments team's variant recommends a 5-minute threshold based on a cost analysis of SLA violations. Both recommendations are evidentially supported; the conflict is a difference in risk framing, not an error on either side."@en ;
    prov:wasGeneratedBy ex:detection-escalation-threshold-contradiction ;
    prov:wasAttributedTo ex:governance-log-service ;
    prov:generatedAtTime "2026-07-10T11:21:40Z"^^xsd:dateTime .

ex:runbook-incident-triage-v3 a prov:Entity .
ex:runbook-incident-triage-payments a prov:Entity .
ex:detection-escalation-threshold-contradiction a prov:Activity .
