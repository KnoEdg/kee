{
  "@context": {
    "@version": 1.1,

    "kee": "https://w3id.org/kee#",
    "profile": "https://w3id.org/kee/profile#",
    "artifact": "https://w3id.org/kee/artifact#",
    "lifecycle": "https://w3id.org/kee/lifecycle#",
    "assertionLifecycle": "https://w3id.org/kee/lifecycle/assertion#",
    "scientificClaimLifecycle": "https://w3id.org/kee/lifecycle/scientific-claim#",
    "organizationalMemoryLifecycle": "https://w3id.org/kee/lifecycle/organizational-memory#",
    "decisionLifecycle": "https://w3id.org/kee/lifecycle/decision#",
    "softwareEngineeringLifecycle": "https://w3id.org/kee/lifecycle/software-engineering#",
    "confidence": "https://w3id.org/kee/confidence#",
    "contradictionCause": "https://w3id.org/kee/vocab/contradiction-cause#",
    "assertionUnitKind": "https://w3id.org/kee/vocab/assertion-unit-kind#",

    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "owl": "http://www.w3.org/2002/07/owl#",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "sh": "http://www.w3.org/ns/shacl#",
    "prov": "http://www.w3.org/ns/prov#",
    "time": "http://www.w3.org/2006/time#",
    "dcterms": "http://purl.org/dc/terms/",
    "dcat": "http://www.w3.org/ns/dcat#",
    "foaf": "http://xmlns.com/foaf/0.1/",
    "schema": "https://schema.org/",
    "vs": "http://www.w3.org/2003/06/sw-vocab-status/ns#",

    "id": "@id",
    "type": "@type",

    "label": {"@id": "rdfs:label", "@container": "@language"},
    "comment": {"@id": "rdfs:comment", "@container": "@language"},
    "definition": {"@id": "skos:definition", "@container": "@language"},
    "scopeNote": {"@id": "skos:scopeNote", "@container": "@language"},
    "changeNote": {"@id": "skos:changeNote", "@container": "@language"},

    "created": {"@id": "dcterms:created", "@type": "xsd:dateTime"},
    "modified": {"@id": "dcterms:modified", "@type": "xsd:dateTime"},
    "issued": {"@id": "dcterms:issued", "@type": "xsd:dateTime"},
    "valid": {"@id": "dcterms:valid"},
    "isReplacedBy": {"@id": "dcterms:isReplacedBy", "@type": "@id"},
    "replaces": {"@id": "dcterms:replaces", "@type": "@id"},
    "hasVersion": {"@id": "dcterms:hasVersion", "@type": "@id"},
    "isVersionOf": {"@id": "dcterms:isVersionOf", "@type": "@id"},
    "hasPart": {"@id": "dcterms:hasPart", "@type": "@id"},
    "conformsTo": {"@id": "dcterms:conformsTo", "@type": "@id"},

    "wasAttributedTo": {"@id": "prov:wasAttributedTo", "@type": "@id"},
    "qualifiedAttribution": {"@id": "prov:qualifiedAttribution", "@type": "@id"},
    "agent": {"@id": "prov:agent", "@type": "@id"},
    "hadRole": {"@id": "prov:hadRole", "@type": "@id"},
    "wasGeneratedBy": {"@id": "prov:wasGeneratedBy", "@type": "@id"},
    "wasDerivedFrom": {"@id": "prov:wasDerivedFrom", "@type": "@id"},
    "wasRevisionOf": {"@id": "prov:wasRevisionOf", "@type": "@id"},
    "wasInvalidatedBy": {"@id": "prov:wasInvalidatedBy", "@type": "@id"},
    "actedOnBehalfOf": {"@id": "prov:actedOnBehalfOf", "@type": "@id"},
    "generatedAtTime": {"@id": "prov:generatedAtTime", "@type": "xsd:dateTime"},
    "invalidatedAtTime": {"@id": "prov:invalidatedAtTime", "@type": "xsd:dateTime"},

    "hasBeginning": {"@id": "time:hasBeginning", "@type": "@id"},
    "hasEnd": {"@id": "time:hasEnd", "@type": "@id"},
    "inXSDDateTimeStamp": {"@id": "time:inXSDDateTimeStamp", "@type": "xsd:dateTimeStamp"},

    "lifecycleState": {"@id": "kee:lifecycleState", "@type": "@id"},
    "artifactType": {"@id": "dcterms:type", "@type": "@id"},
    "profileConformance": {"@id": "dcterms:conformsTo", "@type": "@id"},
    "managedAssertionUnit": {"@id": "kee:managedAssertionUnit", "@type": "@id"},
    "managedAssertionUnitKind": {"@id": "kee:managedAssertionUnitKind", "@type": "@id"},
    "assertionContent": {"@id": "kee:assertionContent"},
    "scope": {"@id": "kee:scope", "@type": "@id"},
    "context": {"@id": "kee:context", "@type": "@id"},
    "authority": {"@id": "kee:authority", "@type": "@id"},
    "reviewDue": {"@id": "kee:reviewDue", "@type": "xsd:dateTime"},
    "confidenceStatus": {"@id": "kee:confidenceStatus", "@type": "@id"},
    "confidenceValue": {"@id": "kee:confidenceValue", "@type": "xsd:decimal"},
    "contradicts": {"@id": "kee:contradicts", "@type": "@id"},
    "supersedes": {"@id": "dcterms:replaces", "@type": "@id"},
    "supersededBy": {"@id": "dcterms:isReplacedBy", "@type": "@id"}
  }
}