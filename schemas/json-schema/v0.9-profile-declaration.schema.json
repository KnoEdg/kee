{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KnoEdg/kee/schemas/json-schema/v0.9-profile-declaration.schema.json",
  "title": "KEE v0.9 candidate profile declaration",
  "description": "Non-normative JSON declaration shape for the v0.9 candidate. This is not an RDF profile ontology.",
  "type": "object",
  "required": [
    "id",
    "version",
    "status",
    "publisher",
    "profileModel",
    "isProfileOf",
    "conformsTo",
    "dependencies",
    "standards",
    "requirementCategories",
    "sharedCoordinationRules",
    "nonCollapseRules",
    "conformanceRequirements",
    "compatibilityPolicy",
    "normativeDocumentation",
    "candidateIdentifierResolutionStatus"
  ],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "const": "0.9.0-candidate"},
    "status": {"type": "string", "const": "proposed"},
    "publisher": {"type": "string", "minLength": 1},
    "profileModel": {"type": "string", "const": "application-profile declaration; not an RDF ontology"},
    "isProfileOf": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "conformsTo": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "compatibilityRange"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "compatibilityRange": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "dependencies": {
      "type": "array",
      "items": {"type": "string"}
    },
    "standards": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "requirementCategories": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["universal", "conditional", "optional-standardized", "domain-defined"]
      },
      "uniqueItems": true
    },
    "sharedCoordinationRules": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "nonCollapseRules": {
      "type": "array",
      "minItems": 17,
      "maxItems": 17,
      "items": {"type": "string", "pattern": "^NC-[0-9]{2}$"},
      "uniqueItems": true
    },
    "conformanceRequirements": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "compatibilityPolicy": {"type": "string", "minLength": 1},
    "normativeDocumentation": {"type": "string", "minLength": 1},
    "candidateIdentifierResolutionStatus": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
