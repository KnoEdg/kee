@prefix ccause: <https://w3id.org/kee/vocab/contradiction-cause#> .
@prefix legacy: <https://knoedg.org/vocab/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

ccause:ContradictionCauseScheme
  a skos:ConceptScheme ;
  skos:prefLabel "KEE Contradiction Cause Scheme" ;
  dcterms:identifier "kee-contradiction-cause-v0.8-rc4" ;
  dcterms:description "Governed open local vocabulary for common contradiction causes. Profiles may use other declared taxonomies; this scheme is not a closed conformance enumeration." .

ccause:DirectContradiction a skos:Concept ; skos:prefLabel "Direct Contradiction" ; skos:definition "Two artifacts make incompatible claims within the same scope, context, and time frame." ; skos:exactMatch legacy:DirectContradiction ; skos:inScheme ccause:ContradictionCauseScheme .
ccause:TemporalContradiction a skos:Concept ; skos:prefLabel "Temporal Contradiction" ; skos:definition "Artifacts appear incompatible because they apply to different or unclear time frames." ; skos:exactMatch legacy:TemporalContradiction ; skos:inScheme ccause:ContradictionCauseScheme .
ccause:ScopeMismatch a skos:Concept ; skos:prefLabel "Scope Mismatch" ; skos:definition "Artifacts appear incompatible because their applicability boundaries differ or are unclear." ; skos:exactMatch legacy:ScopeMismatch ; skos:inScheme ccause:ContradictionCauseScheme .
ccause:ContextMismatch a skos:Concept ; skos:prefLabel "Context Mismatch" ; skos:definition "Artifacts appear incompatible because their interpretive frames differ or are unclear." ; skos:exactMatch legacy:ContextMismatch ; skos:inScheme ccause:ContradictionCauseScheme .
ccause:EvidenceConflict a skos:Concept ; skos:prefLabel "Evidence Conflict" ; skos:definition "Artifacts rely on evidence that supports conflicting conclusions." ; skos:exactMatch legacy:EvidenceConflict ; skos:inScheme ccause:ContradictionCauseScheme .
ccause:AuthorityConflict a skos:Concept ; skos:prefLabel "Authority Conflict" ; skos:definition "Artifacts conflict because different authorities make incompatible governance claims." ; skos:exactMatch legacy:AuthorityConflict ; skos:inScheme ccause:ContradictionCauseScheme .
ccause:MethodConflict a skos:Concept ; skos:prefLabel "Method Conflict" ; skos:definition "Artifacts conflict because different methods, assumptions, or procedures produce incompatible results." ; skos:exactMatch legacy:MethodConflict ; skos:inScheme ccause:ContradictionCauseScheme .
ccause:SemanticConflict a skos:Concept ; skos:prefLabel "Semantic Conflict" ; skos:definition "Artifacts conflict because terms, categories, or meanings are interpreted differently." ; skos:exactMatch legacy:SemanticConflict ; skos:inScheme ccause:ContradictionCauseScheme .

legacy:DirectContradiction skos:exactMatch ccause:DirectContradiction .
legacy:TemporalContradiction skos:exactMatch ccause:TemporalContradiction .
legacy:ScopeMismatch skos:exactMatch ccause:ScopeMismatch .
legacy:ContextMismatch skos:exactMatch ccause:ContextMismatch .
legacy:EvidenceConflict skos:exactMatch ccause:EvidenceConflict .
legacy:AuthorityConflict skos:exactMatch ccause:AuthorityConflict .
legacy:MethodConflict skos:exactMatch ccause:MethodConflict .
legacy:SemanticConflict skos:exactMatch ccause:SemanticConflict .
