@prefix alife: <https://w3id.org/kee/lifecycle/assertion#> .
@prefix legacy: <https://knoedg.org/vocab/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

alife:AssertionLifecycleScheme
  a skos:ConceptScheme ;
  skos:prefLabel "KEE Assertion Lifecycle Scheme" ;
  dcterms:identifier "kee-assertion-lifecycle-v0.8-rc4" ;
  dcterms:description "Canonical RC4 profile lifecycle/disposition scheme for assertions. Preference, challenge, and qualification are separate ranking/dispute/assessment dimensions." .

alife:Proposed a skos:Concept ; skos:prefLabel "Proposed" ; skos:definition "Assertion has been submitted or recorded but not yet accepted for ordinary use." ; skos:exactMatch legacy:ProposedAssertion ; skos:inScheme alife:AssertionLifecycleScheme .
alife:Normal a skos:Concept ; skos:prefLabel "Normal" ; skos:definition "Assertion is active for ordinary use within its declared scope; this does not imply truth, preference, or absence of challenge." ; skos:exactMatch legacy:NormalAssertion ; skos:inScheme alife:AssertionLifecycleScheme .
alife:Deprecated a skos:Concept ; skos:prefLabel "Deprecated" ; skos:definition "Assertion is retained but no longer recommended or is considered problematic." ; skos:exactMatch legacy:DeprecatedAssertion ; skos:inScheme alife:AssertionLifecycleScheme .
alife:Superseded a skos:Concept ; skos:prefLabel "Superseded" ; skos:definition "Assertion has been replaced by another assertion." ; skos:exactMatch legacy:SupersededAssertion ; skos:inScheme alife:AssertionLifecycleScheme .
alife:Rejected a skos:Concept ; skos:prefLabel "Rejected" ; skos:definition "Assertion has been reviewed and not accepted into ordinary use." ; skos:exactMatch legacy:RejectedAssertion ; skos:inScheme alife:AssertionLifecycleScheme .
alife:Withdrawn a skos:Concept ; skos:prefLabel "Withdrawn" ; skos:definition "Assertion has been withdrawn by its source or governing authority." ; skos:exactMatch legacy:WithdrawnAssertion ; skos:inScheme alife:AssertionLifecycleScheme .
alife:Archived a skos:Concept ; skos:prefLabel "Archived" ; skos:definition "Assertion is preserved for historical or compliance reasons; archival preservation does not establish current applicability." ; skos:exactMatch legacy:ArchivedAssertion ; skos:inScheme alife:AssertionLifecycleScheme .

legacy:ProposedAssertion skos:exactMatch alife:Proposed .
legacy:NormalAssertion skos:exactMatch alife:Normal .
legacy:DeprecatedAssertion skos:exactMatch alife:Deprecated .
legacy:SupersededAssertion skos:exactMatch alife:Superseded .
legacy:RejectedAssertion skos:exactMatch alife:Rejected .
legacy:WithdrawnAssertion skos:exactMatch alife:Withdrawn .
legacy:ArchivedAssertion skos:exactMatch alife:Archived .
