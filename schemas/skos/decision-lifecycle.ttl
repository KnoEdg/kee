@prefix dlife: <https://w3id.org/kee/lifecycle/decision#> .
@prefix legacy: <https://knoedg.org/vocab/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

dlife:DecisionLifecycleScheme a skos:ConceptScheme ; skos:prefLabel "KEE Decision Lifecycle Scheme" ; dcterms:identifier "kee-decision-lifecycle-v0.9.2" ; dcterms:description "Canonical profile-specific lifecycle scheme for Decision Profile state." .
dlife:Proposed a skos:Concept ; skos:prefLabel "Proposed" ; skos:definition "Decision is under consideration." ; skos:exactMatch legacy:ProposedDecision ; skos:inScheme dlife:DecisionLifecycleScheme .
dlife:Accepted a skos:Concept ; skos:prefLabel "Accepted" ; skos:definition "Decision is active within its scope." ; skos:exactMatch legacy:AcceptedDecision ; skos:inScheme dlife:DecisionLifecycleScheme .
dlife:Rejected a skos:Concept ; skos:prefLabel "Rejected" ; skos:definition "Decision was considered and not accepted." ; skos:exactMatch legacy:RejectedDecision ; skos:inScheme dlife:DecisionLifecycleScheme .
dlife:Deprecated a skos:Concept ; skos:prefLabel "Deprecated" ; skos:definition "Decision is retained but no longer recommended." ; skos:exactMatch legacy:DeprecatedDecision ; skos:inScheme dlife:DecisionLifecycleScheme .
dlife:Superseded a skos:Concept ; skos:prefLabel "Superseded" ; skos:definition "Decision has been replaced by a later decision." ; skos:exactMatch legacy:SupersededDecision ; skos:inScheme dlife:DecisionLifecycleScheme .
dlife:Withdrawn a skos:Concept ; skos:prefLabel "Withdrawn" ; skos:definition "Decision was withdrawn before acceptance." ; skos:exactMatch legacy:WithdrawnDecision ; skos:inScheme dlife:DecisionLifecycleScheme .
dlife:Archived a skos:Concept ; skos:prefLabel "Archived" ; skos:definition "Decision is retained for historical or compliance purposes." ; skos:exactMatch legacy:ArchivedDecision ; skos:inScheme dlife:DecisionLifecycleScheme .

legacy:ProposedDecision skos:exactMatch dlife:Proposed .
legacy:AcceptedDecision skos:exactMatch dlife:Accepted .
legacy:RejectedDecision skos:exactMatch dlife:Rejected .
legacy:DeprecatedDecision skos:exactMatch dlife:Deprecated .
legacy:SupersededDecision skos:exactMatch dlife:Superseded .
legacy:WithdrawnDecision skos:exactMatch dlife:Withdrawn .
legacy:ArchivedDecision skos:exactMatch dlife:Archived .
