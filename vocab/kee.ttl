    skos:historyNote "Migration: Retained; no migration. Generic lifecycle# values are compatibility-only (§9.2)."@en .

kee:lifecycleStatusVocabulary
    a rdf:Property ;
    rdfs:label "Lifecycle Status Vocabulary"@en ;
    skos:definition "A transition record must identify the profile, source system, controlled vocabulary, or crosswalk context used to interpret the previous and new lifecycle/status terms."@en ;
    rdfs:isDefinedBy <https://w3id.org/kee> ;
    skos:scopeNote "Governance Transition Profile (Draft / Non-Normative); core is owner of record (§6.4). Draft-profile surface; no normative effect from existence or structural validation (§0, §15.6)"@en ;
