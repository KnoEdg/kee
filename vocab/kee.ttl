    rdfs:label "Lifecycle State"@en ;
    skos:definition "Assertion metadata records must declare a lifecycle state from the applicable profile-controlled vocabulary."@en ;
    rdfs:isDefinedBy <https://w3id.org/kee> ;
    skos:scopeNote "artifact-specific profile; core is owner of record while that profile is Draft (§6.4). Draft-profile surface; no normative effect from existence or structural validation (§0, §15.6)"@en ;
