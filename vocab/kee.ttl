# KEE term declarations
#
# Generated from the KEE term registry. Do not edit by hand.
#
# 18 classes, 62 properties, and 10 registered-legacy
# controlled values that no scheme in schemas/skos/ declares.
#
# Each skos:definition is the registry row's audited observable obligation,
# verbatim. This file asserts no domain, range, subclass, subproperty,
# equivalence, or sameAs axiom, and types properties as rdf:Property rather
# than as object or datatype properties: any of those would be a semantic
# claim the specification does not make. External relationships are recorded
# as prose at the strength the registry records, not as mapping triples.
#
# Section references are to docs/specs/KEE-Specification-v0.9.2.md.

<https://w3id.org/kee>
    a owl:Ontology ;
    rdfs:label "KEE term declarations"@en ;
    dcterms:title "KEE term declarations"@en ;
    dcterms:description "Declarations for the KEE-owned classes, properties, and registered-legacy controlled values retained by the KEE v0.9.2 baseline. This document declares and defines terms; it is not a foundational ontology, and it introduces no semantics beyond the specification and the term registry it is generated from."@en ;
    dcterms:conformsTo <https://www.w3.org/TR/rdf-schema/> ;
    dcterms:isReferencedBy "docs/specs/KEE-Specification-v0.9.2.md" ;
    rdfs:comment "The canonical namespaces are persistent identifiers that are not yet registered and do not dereference; see Section 18.7. Read this file from the repository rather than by dereferencing a KEE IRI."@en .

kee:Assertion
    a rdfs:Class ;
    rdfs:label "Assertion"@en ;
    skos:definition "Identify a governed assertion artifact carrying label, definition, provenance, lifecycle, scope, and context."@en ;
    rdfs:isDefinedBy <https://w3id.org/kee> ;
    skos:scopeNote "Assertion Profile (Draft); core is owner of record (§6.4). Draft-profile surface; no normative effect from existence or structural validation (§0, §15.6)"@en ;
    skos:note "External relationship: Composes prov:Entity and SKOS labelling; requires rdfs:label and skos:definition."@en ;
    skos:historyNote "Migration: Retained; no migration."@en .

kee:AssertionMetadataRecord
    a rdfs:Class ;
    rdfs:label "Assertion Metadata Record"@en ;
    skos:definition "Identify the managed assertion unit a metadata record governs, and keep managed-unit, content, record, occurrence, and container identities distinct."@en ;
    rdfs:isDefinedBy <https://w3id.org/kee> ;
    skos:scopeNote "Assertion Metadata Profile (Accepted / Normative). Accepted / Normative profile surface"@en ;
    skos:note "External relationship: Managed-unit kinds map to RDF/nanopublication/record representation prior art through the assertion-unit-kind scheme (§10)."@en ;
    skos:historyNote "Migration: Retained; no migration. Legacy kee:assertionTime is registry-registered (§14.1)."@en .

kee:AssertionOccurrence
    a rdfs:Class ;
    rdfs:label "Assertion Occurrence"@en ;
    skos:definition "Identify the managed assertion unit a metadata record governs, and keep managed-unit, content, record, occurrence, and container identities distinct."@en ;
    rdfs:isDefinedBy <https://w3id.org/kee> ;
    skos:scopeNote "Assertion Metadata Profile (Accepted / Normative). Accepted / Normative profile surface"@en ;
    skos:note "External relationship: Managed-unit kinds map to RDF/nanopublication/record representation prior art through the assertion-unit-kind scheme (§10)."@en ;
    skos:historyNote "Migration: Retained; no migration. Legacy kee:assertionTime is registry-registered (§14.1)."@en .

kee:AuthorityRecord
    a rdfs:Class ;
    rdfs:label "Authority Record"@en ;
    skos:definition "Record who holds authority over what, on which declared basis, for how long, and how that authority ends, separately from provenance."@en ;
    rdfs:isDefinedBy <https://w3id.org/kee> ;
    skos:scopeNote "Authority and Delegation Profile (Draft / Non-Normative); core is owner of record (§6.4). Draft-profile surface; no normative effect from existence or structural validation (§0, §15.6)"@en ;
    skos:note "External relationship: Composes prov:actedOnBehalfOf (Agent-to-Agent), prov:qualifiedAssociation, prov:invalidatedAtTime; XACML/ODRL remain the policy-side prior art."@en ;
    skos:historyNote "Migration: Retained; no migration."@en .

kee:ContestedAuthorityClaim
    a rdfs:Class ;
    rdfs:label "Contested Authority Claim"@en ;
    skos:definition "Record who holds authority over what, on which declared basis, for how long, and how that authority ends, separately from provenance."@en ;
    rdfs:isDefinedBy <https://w3id.org/kee> ;
    skos:scopeNote "Authority and Delegation Profile (Draft / Non-Normative); core is owner of record (§6.4). Draft-profile surface; no normative effect from existence or structural validation (§0, §15.6)"@en ;
    skos:note "External relationship: Composes prov:actedOnBehalfOf (Agent-to-Agent), prov:qualifiedAssociation, prov:invalidatedAtTime; XACML/ODRL remain the policy-side prior art."@en ;
    skos:historyNote "Migration: Retained; no migration."@en .

kee:ContradictionRecord
    a rdfs:Class ;
    rdfs:label "Contradiction Record"@en ;
    skos:definition "Preserve competing artifacts and their per-side evidence without implying resolution, disposition, or falsity."@en ;
    rdfs:isDefinedBy <https://w3id.org/kee> ;
    skos:scopeNote "Contradiction Records Profile (Draft / Non-Normative); core is owner of record (§6.4). Draft-profile surface; no normative effect from existence or structural validation (§0, §15.6)"@en ;
    skos:note "External relationship: Composes oa:Annotation/oa:hasTarget/oa:hasBody via dcterms:hasPart; kee:causeType remains an open IRI slot."@en ;
    skos:historyNote "Migration: Retained; no migration. Flat kee:evidenceForSide is registry-registered legacy (§13.1)."@en .

kee:Decision
    a rdfs:Class ;
    rdfs:label "Decision"@en ;
    skos:definition "Identify a governed ADR-style decision artifact carrying title, context, decision, status, rationale, consequences, and append-only supersession history."@en ;
    rdfs:isDefinedBy <https://w3id.org/kee> ;
    skos:scopeNote "Decision Profile (Draft); core is owner of record (§6.4). Draft-profile surface; no normative effect from existence or structural validation (§0, §15.6)"@en ;
    skos:note "External relationship: Composes dcterms:replaces/dcterms:isReplacedBy and prov:wasRevisionOf for supersession."@en ;
    skos:historyNote "Migration: Retained; no migration."@en .

kee:GovernanceTransitionRecord
    a rdfs:Class ;
    rdfs:label "Governance Transition Record"@en ;
    skos:definition "Represent a governed state-changing act as a provenance-bearing record identifying the governed artifact, prior and resulting state, the controlling vocabulary, and the authority basis."@en ;
    rdfs:isDefinedBy <https://w3id.org/kee> ;
    skos:scopeNote "Governance Transition Profile (Draft / Non-Normative); core is owner of record (§6.4). Draft-profile surface; no normative effect from existence or structural validation (§0, §15.6)"@en ;
    skos:note "External relationship: Composes prov:Activity, prov:qualifiedAssociation, prov:hadRole; no equivalence asserted."@en ;
    skos:historyNote "Migration: Retained; no migration. Wrapper optionality is governed by §8.4."@en .

kee:LifecycleCrosswalkMapping
    a rdfs:Class ;
    rdfs:label "Lifecycle Crosswalk Mapping"@en ;
    skos:definition "Record a lifecycle/status mapping with its source and target vocabulary, terms, and the strength of the mapping relation."@en ;
    rdfs:isDefinedBy <https://w3id.org/kee> ;
    skos:scopeNote "Lifecycle Crosswalk Profile (Draft / Non-Normative); core is owner of record (§6.4). Draft-profile surface; no normative effect from existence or structural validation (§0, §15.6)"@en ;
    skos:note "External relationship: kee:mappingRelationship values are the five SKOS mapping properties; no separate KEE relation code list exists (§16.5)."@en ;
    skos:historyNote "Migration: Retained; no migration."@en .

kee:ManagedArtifactUnit
    a rdfs:Class ;
    rdfs:label "Managed Artifact Unit"@en ;
    skos:definition "Distinguish a managed artifact unit's identity from its content snapshot and its containing graph/dataset/record aggregation."@en ;
    rdfs:isDefinedBy <https://w3id.org/kee> ;
    skos:scopeNote "Artifact Identity and Granularity Profile (Draft / Non-Normative); core is owner of record (§6.4). Draft-profile surface; no normative effect from existence or structural validation (§0, §15.6)"@en ;
    skos:note "External relationship: Composes dcterms:identifier and PROV entity relations; no equivalence asserted."@en ;
    skos:historyNote "Migration: Retained; no migration."@en .

kee:OrganizationalMemoryArtifact
    a rdfs:Class ;
    rdfs:label "Organizational Memory Artifact"@en ;
    skos:definition "Declare stewardship and review policy for a retained organizational-memory artifact without implying a decay or truth model."@en ;
    rdfs:isDefinedBy <https://w3id.org/kee> ;
    skos:scopeNote "Organizational Memory Profile (Draft); core is owner of record (§6.4). Draft-profile surface; no normative effect from existence or structural validation (§0, §15.6)"@en ;
    skos:note "External relationship: Composes PROV qualified attribution for stewardship; review scheduling has no adopted external term."@en ;
    skos:historyNote "Migration: Retained; no migration."@en .

kee:PointInTimeQuery
    a rdfs:Class ;
    rdfs:label "Point In Time Query"@en ;
    skos:definition "Make a point-in-time query's intent mechanically identifiable: requested target, time dimension, query pattern, and the history source whose coverage bounds the answer."@en ;
    rdfs:isDefinedBy <https://w3id.org/kee> ;
    skos:scopeNote "Historical and Bitemporal Querying Profile (Draft / Non-Normative); core is owner of record (§6.4). Draft-profile surface; no normative effect from existence or structural validation (§0, §15.6)"@en ;
    skos:note "External relationship: dcterms:temporal carries the requested instant/interval; time:Instant/time:Interval carry coverage; the dimension and pattern classifiers are open IRI slots with no external code list adopted."@en ;
    skos:historyNote "Migration: Retained; no migration. Legacy kee:queryInstant and kee:historyCompleteness are registry-registered (§14.2, §14.3)."@en .

kee:PromotionRecord
    a rdfs:Class ;
    rdfs:label "Promotion Record"@en ;
    skos:definition "Distinguish an authorized, deliberate expansion of a governed artifact's applicability scope from ordinary revision, publication, popularity, or lifecycle change."@en ;
    rdfs:isDefinedBy <https://w3id.org/kee> ;
    skos:scopeNote "Promotion Profile (Draft / Non-Normative); core is owner of record (§6.4). Draft-profile surface; no normative effect from existence or structural validation (§0, §15.6)"@en ;
    skos:note "External relationship: Scope ordering uses skos:broader/skos:narrower or another profile-declared partial order; no external equivalent for the discriminator was located."@en ;
    skos:historyNote "Migration: Retained; no migration. Prior-art ownership of the discriminator remains an open question (Phase 5 ledger)."@en .

kee:RetrievalChunk
