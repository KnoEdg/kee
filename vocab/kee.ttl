    skos:definition "A crosswalk record must identify the source lifecycle/status term being mapped rather than silently replacing it with a target term."@en ;
    rdfs:isDefinedBy <https://w3id.org/kee> ;
    skos:scopeNote "Lifecycle Crosswalk Profile (Draft / Non-Normative); core is owner of record (§6.4). Draft-profile surface; no normative effect from existence or structural validation (§0, §15.6)"@en ;
    skos:note "External relationship: kee:mappingRelationship values are the five SKOS mapping properties; no separate KEE relation code list exists (§16.5)."@en ;
    skos:historyNote "Migration: Retained; no migration."@en .

kee:sourceVocabulary
    a rdf:Property ;
    rdfs:label "Source Vocabulary"@en ;
    skos:definition "A crosswalk record must identify the source vocabulary or system supplying the source term; the source vocabulary remains independently identifiable after mapping."@en ;
    rdfs:isDefinedBy <https://w3id.org/kee> ;
    skos:scopeNote "Lifecycle Crosswalk Profile (Draft / Non-Normative); core is owner of record (§6.4). Draft-profile surface; no normative effect from existence or structural validation (§0, §15.6)"@en ;
    skos:note "External relationship: kee:mappingRelationship values are the five SKOS mapping properties; no separate KEE relation code list exists (§16.5)."@en ;
    skos:historyNote "Migration: Retained; no migration."@en .

kee:supersessionChainTarget
    a rdf:Property ;
    rdfs:label "Supersession Chain Target"@en ;
    skos:definition "Optional derived/cache terminal target from retained dcterms:replaces/dcterms:isReplacedBy and applicable PROV revision lineage; this cache must not replace or suppress that chain."@en ;
    rdfs:isDefinedBy <https://w3id.org/kee> ;
    skos:scopeNote "core interoperability contract. legacy-readable"@en ;
    skos:note "External relationship: canonical surface: derived replacement-chain terminal"@en ;
    skos:historyNote "Deprecated: registered legacy. Migration: Registry: tooling-only-removed, rewrite_safe=false (§8.3)."@en ;
    owl:deprecated true .

kee:targetTerm
    a rdf:Property ;
    rdfs:label "Target Term"@en ;
    skos:definition "A crosswalk record must identify the target lifecycle/status term or category used for comparison."@en ;
    rdfs:isDefinedBy <https://w3id.org/kee> ;
    skos:scopeNote "Lifecycle Crosswalk Profile (Draft / Non-Normative); core is owner of record (§6.4). Draft-profile surface; no normative effect from existence or structural validation (§0, §15.6)"@en ;
    skos:note "External relationship: kee:mappingRelationship values are the five SKOS mapping properties; no separate KEE relation code list exists (§16.5)."@en ;
    skos:historyNote "Migration: Retained; no migration."@en .

kee:targetVocabulary
    a rdf:Property ;
    rdfs:label "Target Vocabulary"@en ;
    skos:definition "A crosswalk record must identify the target profile or vocabulary used as the mapping target."@en ;
    rdfs:isDefinedBy <https://w3id.org/kee> ;
    skos:scopeNote "Lifecycle Crosswalk Profile (Draft / Non-Normative); core is owner of record (§6.4). Draft-profile surface; no normative effect from existence or structural validation (§0, §15.6)"@en ;
    skos:note "External relationship: kee:mappingRelationship values are the five SKOS mapping properties; no separate KEE relation code list exists (§16.5)."@en ;
    skos:historyNote "Migration: Retained; no migration."@en .

kee:unresolvedSince
    a rdf:Property ;
    rdfs:label "Unresolved Since"@en ;
    skos:definition "Preserve competing artifacts and their per-side evidence without implying resolution, disposition, or falsity."@en ;
    rdfs:isDefinedBy <https://w3id.org/kee> ;
    skos:scopeNote "Contradiction Records Profile (Draft / Non-Normative); core is owner of record (§6.4). Draft-profile surface; no normative effect from existence or structural validation (§0, §15.6)"@en ;
    skos:note "External relationship: Composes oa:Annotation/oa:hasTarget/oa:hasBody via dcterms:hasPart; kee:causeType remains an open IRI slot."@en ;
    skos:historyNote "Migration: Retained; no migration. Flat kee:evidenceForSide is registry-registered legacy (§13.1)."@en .

kee:validFrom
    a rdf:Property ;
    rdfs:label "Valid From"@en ;
    skos:definition "Record who holds authority over what, on which declared basis, for how long, and how that authority ends, separately from provenance."@en ;
    rdfs:isDefinedBy <https://w3id.org/kee> ;
    skos:scopeNote "Authority and Delegation Profile (Draft / Non-Normative); core is owner of record (§6.4). Draft-profile surface; no normative effect from existence or structural validation (§0, §15.6)"@en ;
    skos:note "External relationship: Composes prov:actedOnBehalfOf (Agent-to-Agent), prov:qualifiedAssociation, prov:invalidatedAtTime; XACML/ODRL remain the policy-side prior art."@en ;
    skos:historyNote "Migration: Retained; no migration."@en .

kee:validUntil
    a rdf:Property ;
    rdfs:label "Valid Until"@en ;
    skos:definition "Record who holds authority over what, on which declared basis, for how long, and how that authority ends, separately from provenance."@en ;
    rdfs:isDefinedBy <https://w3id.org/kee> ;
    skos:scopeNote "Authority and Delegation Profile (Draft / Non-Normative); core is owner of record (§6.4). Draft-profile surface; no normative effect from existence or structural validation (§0, §15.6)"@en ;
    skos:note "External relationship: Composes prov:actedOnBehalfOf (Agent-to-Agent), prov:qualifiedAssociation, prov:invalidatedAtTime; XACML/ODRL remain the policy-side prior art."@en ;
    skos:historyNote "Migration: Retained; no migration."@en .

kee:warningContent
    a rdf:Property ;
    rdfs:label "Warning Content"@en ;
    skos:definition "Record a consumer-scoped retrieval eligibility decision, its basis, its warning/review routing, and the granularity at which the result may be cited, without mutating source semantics."@en ;
    rdfs:isDefinedBy <https://w3id.org/kee> ;
    skos:scopeNote "AI-Grounded Retrieval Profile (Draft / Non-Normative); core is owner of record (§6.4). Draft-profile surface; no normative effect from existence or structural validation (§0, §15.6)"@en ;
    skos:note "External relationship: Composes prov:wasGeneratedBy/prov:generatedAtTime for decision provenance; categories are open IRI slots."@en ;
    skos:historyNote "Migration: Retained; no migration."@en .

