kee:managedAssertionUnit
    a rdf:Property ;
    rdfs:label "Managed Assertion Unit"@en ;
    skos:definition "The metadata record must identify the managed assertion unit it governs. This does not assert that the managed unit is identical to assertion content/proposition, assertion occurrence, metadata record, or containing repr"@en ;
    rdfs:isDefinedBy <https://w3id.org/kee> ;
    skos:scopeNote "Assertion Metadata Profile (Accepted / Normative). Accepted / Normative profile surface"@en ;
    skos:note "External relationship: Managed-unit kinds map to RDF/nanopublication/record representation prior art through the assertion-unit-kind scheme (§10)."@en ;
    skos:historyNote "Migration: Retained; no migration. Legacy kee:assertionTime is registry-registered (§14.1)."@en .

kee:managedAssertionUnitKind
    a rdf:Property ;
    rdfs:label "Managed Assertion Unit Kind"@en ;
    skos:definition "Managed-unit kind is optional and open. Implementations are recommended to use a term from the shared assertion-unit-kind scheme where applicable or another declared profile/domain IRI for a representation pattern the sc"@en ;
    rdfs:isDefinedBy <https://w3id.org/kee> ;
    skos:scopeNote "Assertion Metadata Profile (Accepted / Normative). Accepted / Normative profile surface"@en ;
    skos:note "External relationship: Managed-unit kinds map to RDF/nanopublication/record representation prior art through the assertion-unit-kind scheme (§10)."@en ;
    skos:historyNote "Migration: Retained; no migration. Legacy kee:assertionTime is registry-registered (§14.1)."@en .

kee:managedUnit
    a rdf:Property ;
    rdfs:label "Managed Unit"@en ;
    skos:definition "Identify the managed assertion unit a metadata record governs, and keep managed-unit, content, record, occurrence, and container identities distinct."@en ;
    rdfs:isDefinedBy <https://w3id.org/kee> ;
    skos:scopeNote "Assertion Metadata Profile (Accepted / Normative). orphan; used in one RO-Crate example and by no shape, profile, or specification section"@en ;
