@prefix ex: <https://example.org/kee/test/> .
@prefix kee: <https://w3id.org/kee#> .
@prefix profile: <https://w3id.org/kee/profile#> .
@prefix artifact: <https://w3id.org/kee/artifact#> .
@prefix lifecycle: <https://w3id.org/kee/lifecycle#> .
@prefix confidence: <https://w3id.org/kee/confidence#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
# Compatibility note (specification Section 17): this fixture exercises registered
# legacy-readable surfaces (generic https://w3id.org/kee/lifecycle# values and/or
# legacy carriers). It is executable compatibility evidence, not canonical
# new-write guidance; profile-aware migration of lifecycle values is registered
# as unsafe for automatic rewrite (specification Section 9.2 and Section 17).

# Valid new-write fixture for shacl/scientific-claim-profile.ttl.
# Publication/governance lifecycle is independent from evidence/challenge.
# Expected result: conforms.

ex:scientific-claim-valid-001
    a kee:ScientificClaim ;
    rdfs:label "Valid scientific claim fixture"@en ;
    skos:definition "This scientific claim fixture includes all required Scientific Claim Profile properties."@en ;

    dcterms:type artifact:ScientificClaim ;
    kee:lifecycleState lifecycle:Published ;
    dcterms:conformsTo profile:ScientificClaimProfile ;
    kee:scope ex:scope-test ;
    kee:context ex:context-test ;
    kee:confidenceStatus confidence:ProfileDefined ;
    kee:confidenceValue "0.75"^^xsd:decimal ;
    kee:evidenceStrength ex:evidence-strength-test ;
    kee:replicationStatus ex:replication-status-test ;

    prov:wasAttributedTo ex:agent-test ;
    prov:generatedAtTime "2026-07-08T21:00:00Z"^^xsd:dateTime ;

    dcterms:source ex:source-test .

ex:agent-test a prov:Agent ; rdfs:label "Test agent"@en .
ex:scope-test a skos:Concept ; skos:prefLabel "Test scope"@en .
ex:context-test a skos:Concept ; skos:prefLabel "Test context"@en .
ex:source-test a prov:Entity ; rdfs:label "Test source"@en .
ex:evidence-strength-test a skos:Concept ; skos:prefLabel "Test evidence strength"@en .
ex:replication-status-test a skos:Concept ; skos:prefLabel "Test replication status"@en .
