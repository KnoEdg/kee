# Compatibility note (specification Section 17): this fixture exercises registered
# legacy-readable surfaces (generic https://w3id.org/kee/lifecycle# values and/or
# legacy carriers). It is executable compatibility evidence, not canonical
# new-write guidance; profile-aware migration of lifecycle values is registered
# as unsafe for automatic rewrite (specification Section 9.2 and Section 17).

# Invalid fixture for shacl/contradiction-records-profile.ttl
# Expected result: does not conform.
# Expected failure: only one kee:conflictingArtifact value, violating the
# minCount 2 requirement -- a contradiction requires at least two
# conflicting artifacts (a recorded project decision; see the profile's own Candidate
# Validation Constraints: "a contradiction record links at least two
# conflicting artifacts").

ex:contradiction-invalid-missing-second-artifact-001
    a kee:ContradictionRecord ;
    rdfs:label "Invalid contradiction record fixture with only one conflicting artifact"@en ;

    kee:conflictingArtifact ex:artifact-a-test ;
    kee:lifecycleState grlife:Accepted ;
    kee:profileConformance profile:ContradictionRecordsProfile ;

    prov:wasGeneratedBy ex:detection-activity-test ;
    prov:wasAttributedTo ex:agent-test ;
    prov:generatedAtTime "2026-07-10T21:10:00Z"^^xsd:dateTime .

ex:artifact-a-test
    a prov:Entity ;
    rdfs:label "Test artifact A"@en .

ex:detection-activity-test
    a prov:Activity ;
    rdfs:label "Test detection activity"@en .

ex:agent-test
    a prov:Agent ;
    rdfs:label "Test agent"@en .
