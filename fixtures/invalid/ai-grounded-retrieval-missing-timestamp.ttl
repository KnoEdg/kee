# Invalid fixture for shacl/ai-grounded-retrieval-profile.ttl
# Expected result: does not conform.
# Expected failure: missing required prov:generatedAtTime on a
# kee:RetrievalQuery -- the retrieval/answer-time timestamp this profile's
# own Baseline Retrieval-Eligibility Categories table requires (per
# a recorded project decision).

ex:retrieval-query-invalid-missing-timestamp-001
    a kee:RetrievalQuery ;
    rdfs:label "Invalid retrieval query fixture missing timestamp"@en ;

    kee:profileConformance profile:AIGroundedRetrievalProfile .
