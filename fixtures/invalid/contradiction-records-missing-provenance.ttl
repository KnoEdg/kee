@prefix ex: <https://example.org/kee/test/> .
@prefix kee: <https://w3id.org/kee#> .
@prefix profile: <https://w3id.org/kee/profile#> .
@prefix grlife: <https://w3id.org/kee/lifecycle/governance-record#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
# Compatibility note (specification Section 17): this fixture exercises registered
# legacy-readable surfaces (generic https://w3id.org/kee/lifecycle# values and/or
# legacy carriers). It is executable compatibility evidence, not canonical
# new-write guidance; profile-aware migration of lifecycle values is registered
# as unsafe for automatic rewrite (specification Section 9.2 and Section 17).

# Invalid fixture for shacl/contradiction-records-profile.ttl
# Expected result: does not conform.
# Expected failure: missing required prov:wasGeneratedBy,
# prov:wasAttributedTo, and prov:generatedAtTime.

ex:contradiction-invalid-missing-provenance-001
    a kee:ContradictionRecord ;
    rdfs:label "Invalid contradiction record fixture missing provenance"@en ;

    kee:conflictingArtifact ex:artifact-a-test, ex:artifact-b-test ;
    kee:lifecycleState grlife:Accepted ;
    kee:profileConformance profile:ContradictionRecordsProfile .

ex:artifact-a-test
    a prov:Entity ;
    rdfs:label "Test artifact A"@en .

ex:artifact-b-test
    a prov:Entity ;
    rdfs:label "Test artifact B"@en .
