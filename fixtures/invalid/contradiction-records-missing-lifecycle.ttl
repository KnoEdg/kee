# legacy-readable surfaces (generic https://w3id.org/kee/lifecycle# values and/or
# legacy carriers). It is executable compatibility evidence, not canonical
# new-write guidance; profile-aware migration of lifecycle values is registered
# as unsafe for automatic rewrite (specification Section 9.2 and Section 17).

# Invalid fixture for shacl/contradiction-records-profile.ttl
# Expected result: does not conform.
# Expected failure: missing required kee:lifecycleState.

ex:contradiction-invalid-missing-lifecycle-001
    a kee:ContradictionRecord ;
    rdfs:label "Invalid contradiction record fixture missing lifecycle"@en ;

    kee:conflictingArtifact ex:artifact-a-test, ex:artifact-b-test ;
    kee:profileConformance profile:ContradictionRecordsProfile ;

    prov:wasGeneratedBy ex:detection-activity-test ;
    prov:wasAttributedTo ex:agent-test ;
    prov:generatedAtTime "2026-07-10T21:05:00Z"^^xsd:dateTime .

ex:artifact-a-test
    a prov:Entity ;
    rdfs:label "Test artifact A"@en .

ex:artifact-b-test
    a prov:Entity ;
    rdfs:label "Test artifact B"@en .

ex:detection-activity-test
    a prov:Activity ;
    rdfs:label "Test detection activity"@en .

ex:agent-test
    a prov:Agent ;
    rdfs:label "Test agent"@en .
