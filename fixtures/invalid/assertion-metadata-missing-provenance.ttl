@prefix ex: <https://example.org/kee/test/> .
@prefix kee: <https://w3id.org/kee#> .
@prefix profile: <https://w3id.org/kee/profile#> .
@prefix alife: <https://w3id.org/kee/lifecycle/assertion#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
# Compatibility note (specification Section 17): this fixture exercises registered
# legacy-readable surfaces (generic https://w3id.org/kee/lifecycle# values and/or
# legacy carriers). It is executable compatibility evidence, not canonical
# new-write guidance; profile-aware migration of lifecycle values is registered
# as unsafe for automatic rewrite (specification Section 9.2 and Section 17).

# Invalid fixture for shacl/assertion-metadata-profile.ttl
# Expected result: does not conform.
# Expected failure: missing required prov:wasAttributedTo and
# prov:generatedAtTime.

ex:assertion-metadata-invalid-missing-provenance-001
    a kee:AssertionMetadataRecord ;
    rdfs:label "Invalid assertion metadata fixture missing provenance"@en ;

    kee:managedAssertionUnit ex:assertion-unit-test ;
    kee:assertionContent ex:assertion-unit-test ;
    kee:lifecycleState alife:Normal ;
    kee:profileConformance profile:AssertionMetadataProfile ;
    kee:scope ex:scope-test ;
    kee:context ex:context-test ;

    dcterms:source ex:source-test .

ex:assertion-unit-test
    a prov:Entity ;
    rdfs:label "Test managed assertion unit"@en .

ex:scope-test
    a skos:Concept ;
    skos:prefLabel "Test scope"@en .

ex:context-test
    a skos:Concept ;
    skos:prefLabel "Test context"@en .

ex:source-test
    a prov:Entity ;
    rdfs:label "Test source"@en .
